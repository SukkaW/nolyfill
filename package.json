{
  "name": "nolyfill-monorepo",
  "version": "1.0.44",
  "private": true,
  "files": [],
  "scripts": {
    "lint": "eslint --format sukka .",
    "build:tsc": "tsc -b tsconfig.build.json",
    "build": "turbo run build",
    "build:analyze": "ANALYZE=true turbo run build",
    "codegen": "node -r @swc-node/register create.ts",
    "prerelease": "turbo run build",
    "release": "bumpp --all --commit \"release: %s\" --tag \"%s\"",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@eslint-sukka/node": "^9.1.0",
    "@jsdevtools/ez-spawn": "^3.0.4",
    "@nolyfill/internal": "workspace:*",
    "@package-json/types": "^0.0.13",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^20.19.43",
    "bumpp": "^9.11.1",
    "dequal": "2.0.3",
    "eslint": "^10.11.0",
    "eslint-config-sukka": "^9.1.0",
    "eslint-formatter-sukka": "^9.1.0",
    "path-scurry": "^2.0.2",
    "picocolors": "^1.1.1",
    "premove": "^4.0.0",
    "rollup": "^4.63.5",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-swc3": "^0.12.1",
    "turbo": "^2.11.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=16.8.0"
  }
