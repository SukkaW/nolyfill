{
  "name": "nolyfill",
  "version": "1.0.44",
  "homepage": "https://github.com/SukkaW/nolyfill",
  "repository": "https://github.com/SukkaW/nolyfill",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": "bin/nolyfill.js",
  "files": [
    "!dist/stats.html",
    "bin",
    "dist/**"
