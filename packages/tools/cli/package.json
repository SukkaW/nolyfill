    "@jsdevtools/ez-spawn": "^3.0.4",
    "@napi-rs/magic-string": "^0.3.4",
    "@nolyfill/internal": "workspace:*",
    "@nolyfill/promise.any": "workspace:*",
    "@npmcli/arborist": "^9.9.2",
    "@npmcli/map-workspaces": "^5.0.0",
    "@pnpm/dependency-path": "^1001.1.11",
    "@pnpm/dependency-path--old": "npm:@pnpm/dependency-path@^2.1.8",
    "@pnpm/lockfile-file--old": "npm:@pnpm/lockfile-file@^8.1.8",
    "@pnpm/lockfile-utils--old": "npm:@pnpm/lockfile-utils@^9.0.6",
    "@pnpm/lockfile.fs": "^1001.1.35",
